+# Lock overlay: while LOCK["locked"], relays send BLANK_FRAME (an empty video
+# payload) in place of every desktop frame, so no desktop pixels leave the host.
+# Driven by the text command `STYX_LOCK,1` / `STYX_LOCK,0` (see handle_lock_command).
+BLANK_FRAME = b""
+LOCK = {"locked": False}
+
+
+def set_lock(locked):
+    LOCK["locked"] = bool(locked)
+
+
+def handle_lock_command(msg):
+    """True if msg was a lock command (and was applied)."""
+    if msg in ("STYX_LOCK,1", "STYX_LOCK,0"):
+        set_lock(msg.endswith("1"))
+        return True
+    return False
 
 
