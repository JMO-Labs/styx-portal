+# Lock overlay (Styx): while LOCK["locked"], no video frame is written to any
+# page, so no desktop pixels leave the host. Driven by the text message
+# `STYX_LOCK,<1|0>,<token>`; the token is STYX_LOCK_TOKEN from the environment,
+# held by the gateway only. With no token configured every lock message is refused.
+LOCK = {"locked": False}
+
+
+def handle_lock_command(message: str) -> Optional[bool]:
+    """None if `message` is not a lock command; True if applied; False if refused."""
+    if not message.startswith("STYX_LOCK,"):
+        return None
+    parts = message.split(",", 2)
+    token = os.environ.get("STYX_LOCK_TOKEN", "")
+    if (len(parts) != 3 or parts[1] not in ("0", "1") or not token
+            or not secrets.compare_digest(parts[2].encode(), token.encode())):
+        return False
+    LOCK["locked"] = parts[1] == "1"
+    return True
 # Frames a run left out of a page may span before the encoder is told without
