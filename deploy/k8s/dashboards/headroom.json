{
  "uid": "styx-slo-headroom",
  "title": "Styx SLO: Capacity headroom",
  "description": "SLI: share of time peak desktops stay below 80% of cluster pod capacity; budget 5%.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "styx",
    "slo"
  ],
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLI (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((max(styx_capacity_peak_desktops) / sum(kube_node_status_allocatable{resource=\"pods\"}) < bool 0.8)[30d:5m])"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (1 - avg_over_time((max(styx_capacity_peak_desktops) / sum(kube_node_status_allocatable{resource=\"pods\"}) < bool 0.8)[30d:5m])) / 0.05"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Burn rate (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - avg_over_time((max(styx_capacity_peak_desktops) / sum(kube_node_status_allocatable{resource=\"pods\"}) < bool 0.8)[1h:5m])) / 0.05"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Peak desktops",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(styx_capacity_peak_desktops)",
          "legendFormat": "peak desktops"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Headroom ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - max(styx_capacity_peak_desktops) / sum(kube_node_status_allocatable{resource=\"pods\"})",
          "legendFormat": "headroom"
        }
      ]
    }
  ]
}
